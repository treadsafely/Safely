{
  "cli": {
    "version": ">= 16.27.0",
    "appVersionSource": "remote"
  },
  "build": {
    "staging-base": {
      "autoIncrement": true,
      "ios": {
        "distribution": "store",
        "buildArtifactPaths": ["ios/Podfile.lock"]
      },
      "android": {
        "buildType": "apk",
        "resourceClass": "large",
        "buildArtifactPaths": [
          "android/app/build/outputs/sdk-dependencies/release/sdkDependencies.txt"
        ]
      }
    },
    "staging-cached": {
      "extends": "staging-base",
      "env": {
        "EAS_USE_CACHE": "1",
        "EAS_GRADLE_CACHE": "1"
      }
    },
    "production": {
      "extends": "staging-base",
      "android": {
        "buildType": "app-bundle",
        "resourceClass": "large",
        "buildArtifactPaths": [
          "android/app/build/intermediates/metadata_library_dependencies_report/release/**/dependencies.pb"
        ]
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6784663848"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
