{
  "name": "@safely/mobile",
  "version": "1.2.5",
  "license": "Apache-2.0",
  "main": "index.tsx",
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "icons": "node scripts/generate-icons-file.js",
    "compile": "tsc --noEmit",
    "build": "pnpm dlx eas-cli workflow:run build-and-distribute.yml --input release_notes=\"$(git branch --show-current)\"",
    "lint": "eslint ./src ./scripts",
    "test": "pnpm run test:js",
    "test:all": "pnpm run test:js && pnpm run test:ios && pnpm run test:android",
    "test:js": "vitest run",
    "test:ios": "cd modules/safely-crypto/ios && swift test && cd ../../safely-push-content/ios && swift test",
    "test:android": "cd modules/safely-crypto/android/host-test && ./gradlew test && cd ../../../safely-push-content/android/host-test && ./gradlew test"
  },
