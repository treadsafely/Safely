<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The main binary only. `amfid` validates these against the embedded provisioning profile:
         a key the profile does not grant stops the app from launching at all. -->
    <key>com.apple.application-identifier</key>
    <string>3ZVCUSJU6R.com.safely.wallet-desktop</string>

    <key>com.apple.developer.team-identifier</key>
    <string>3ZVCUSJU6R</string>

    <!-- The access group the data protection keychain items live in. -->
    <key>keychain-access-groups</key>
    <array>
        <string>3ZVCUSJU6R.com.safely.wallet-desktop</string>
    </array>

    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- The QR scanner. Listed on the helper too: the capture runs in the GPU process, and the
         hardened runtime checks resource access per process. -->
    <key>com.apple.security.device.camera</key>
    <true/>
</dict>
</plist>
