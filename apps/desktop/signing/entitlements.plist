<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The main binary only. `amfid` validates these against the embedded provisioning profile:
         a key the profile does not grant stops the app from launching at all. -->
    <key>com.apple.application-identifier</key>
    <string>3ZVCUSJU6R.com.safely.wallet-desktop</string>

    <key>com.apple.developer.team-identifier</key>
    <string>3ZVCUSJU6R</string>

    <!-- The access group the data protection keychain items live in. -->
    <key>keychain-access-groups</key>
    <array>
        <string>3ZVCUSJU6R.com.safely.wallet-desktop</string>
    </array>

    <!-- The Mac App Store admits sandboxed apps only; the helpers inherit this sandbox. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Chromium in a MAS build names its shared memory and Mach ports under this group, built from
         `ElectronTeamID` and the bundle id: a mismatch leaves the helpers unable to start. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>3ZVCUSJU6R.com.safely.wallet-desktop</string>
    </array>

    <key>com.apple.security.network.client</key>
    <true/>

    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- The QR scanner. The capture runs in the GPU helper, which reaches the camera through the
         sandbox it inherits from here. -->
    <key>com.apple.security.device.camera</key>
    <true/>

    <!-- The Ledger over WebHID. IOKit refuses a HID device to a sandboxed process without it, and
         the processes Chromium opens the device from inherit this sandbox. -->
    <key>com.apple.security.device.usb</key>
    <true/>
</dict>
</plist>
