{
  "name": "@safely/desktop",
  "version": "1.0.0",
  "private": true,
  "productName": "Safely",
  "type": "commonjs",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "build:native:mas": "node-gyp rebuild -C native/keychain",
    "build:native:win32": "node-gyp rebuild -C native/hello",
    "package:mas": "pnpm run build:native:mas && electron-forge package --platform=mas",
    "make:mas": "pnpm run build:native:mas && electron-forge make --platform=mas",
    "package:win32": "pnpm run build:native:win32 && electron-forge package --platform=win32",
    "make:win32": "pnpm run build:native:win32 && electron-forge make --platform=win32",
    "compile": "tsc --noEmit",
    "lint": "eslint ./src",
    "test": "vitest run"
  },
  "dependencies": {
    "@ledgerhq/device-management-kit": "catalog:",
    "@ledgerhq/device-transport-kit-web-hid": "1.2.3",
    "@noble/hashes": "catalog:",
    "@runflame/wallet-wasm": "0.0.1-rc.46",
    "@safely/core": "workspace:*",
    "@safely/sync": "workspace:*",
    "@safely/ux": "workspace:*",
    "@safely/web-ui": "workspace:*",
    "@safely/xhr-event-source": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "1.170.45",
    "buffer": "6.0.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-msix": "7.11.2",
    "@electron-forge/maker-pkg": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@pandacss/postcss": "1.12.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.8.1",
    "node-addon-api": "8.5.0",
    "node-gyp": "12.4.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-svgr": "catalog:",
    "vitest": "catalog:"
  }
}
